<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon — 하루온도
  Monochrome white arc on transparent background.
  Matches the launcher arc geometry (top-arch, sweep clockwise).
  strokeWidth kept at 2.5 for legibility in the status bar at small sizes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M 4,16 A 8,8 0 0 1 20,16"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"/>
</vector>
